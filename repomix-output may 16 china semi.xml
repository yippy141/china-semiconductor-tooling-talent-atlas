                                      No analyst notes recorded.
                                    </p>
                                  )}
                                </div>
                              </td>
                            </tr>
                          ) : null}
                        </Fragment>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </div>
          )}
        </section>

        <footer className="flex flex-col gap-3 border-t border-stone-300 pt-8 text-sm leading-7 text-stone-700 sm:flex-row sm:items-center sm:justify-between">
          <p>
            Continue reading:{" "}
