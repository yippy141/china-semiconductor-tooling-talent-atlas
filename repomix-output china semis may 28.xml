            </svg>
          </div>

          <div class="ba-card after">
            <div class="h">Proposed — first two scrolls</div>
            <svg viewBox="0 0 320 360" xmlns="http://www.w3.org/2000/svg">
              <rect x="0" y="0" width="320" height="360" fill="#f3efe7"/>
              <!-- hero -->
