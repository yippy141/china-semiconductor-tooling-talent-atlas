                </article>
              ))}
            </div>
          )}
        </section>

        <section className="grid gap-6 lg:grid-cols-2">
          <ListPanel
            eyebrow="Likely bottlenecks"
            title="Where the hard problems sit"
            items={profile.likelyBottlenecks}
