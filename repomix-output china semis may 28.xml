              <rect x="244" y="226" width="56" height="6" fill="#1c1917"/>
              <text x="228" y="252" font-family="IBM Plex Mono" font-size="7" fill="#b07418">02</text>
              <rect x="244" y="246" width="56" height="6" fill="#1c1917"/>
              <text x="228" y="272" font-family="IBM Plex Mono" font-size="7" fill="#b07418">03</text>
              <rect x="244" y="266" width="56" height="6" fill="#1c1917"/>
              <!-- credibility band -->
              <line x1="14" y1="306" x2="306" y2="306" stroke="#1c1917"/>
              <g font-family="Source Serif 4" font-weight="500" fill="#1c1917">
                <text x="14" y="328" font-size="6" font-family="IBM Plex Sans" fill="#8a8174" letter-spacing="1.5">SOURCE BASE</text>
                <text x="80"  y="334" font-size="16">43</text>
                <text x="140" y="334" font-size="16">143</text>
                <text x="210" y="334" font-size="16">4</text>
                <text x="260" y="334" font-size="16">4</text>
              </g>
              <g font-family="IBM Plex Sans" font-size="5.5" fill="#8a8174" letter-spacing="1">
                <text x="80"  y="346">SOURCES</text>
                <text x="140" y="346">ROWS</text>
