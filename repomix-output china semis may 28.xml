  .e-row:last-of-type { border-bottom: 0; }
  .e-row .firm {
    font-family: var(--serif);
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
  }
  .e-row .firm small {
    display: block;
    font-family: var(--sans);
    font-weight: 400;
    font-size: 10px;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-top: 2px;
    text-transform: uppercase;
  }
  .e-row .figure {
    font-family: var(--serif);
    font-feature-settings: "tnum";
    font-size: 22px;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .e-row .figure small {
    display: block;
    font-family: var(--sans);
    font-size: 9px;
    letter-spacing: 0.14em;
    color: var(--muted);
    text-align: right;
    margin-top: 2px;
    text-transform: uppercase;
    font-weight: 500;
  }
  .e-note {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid var(--rule-hair);
    font-family: var(--sans);
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.04em;
    line-height: 1.45;
  }

  /* ── second scroll — the argument ─────────────── */
  .m-arg {
    padding: 48px 48px 56px;
    background: var(--paper);
  }
  .m-arg-head {
    display: grid;
    grid-template-columns: 96px 1fr;
    gap: 32px;
    align-items: baseline;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 24px;
  }
  .m-arg-num {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--muted);
    text-transform: uppercase;
  }
  .m-arg-num::before { content: "§"; margin-right: 6px; color: var(--accent); font-family: var(--serif); font-style: italic; }
  .m-arg-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 36px;
    line-height: 1.05;
    margin: 0;
    letter-spacing: -0.015em;
    max-width: 22ch;
  }

  .m-arg-grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: 96px 1.1fr 1fr;
    gap: 32px;
  }
  .m-arg-lede {
    font-family: var(--serif);
    font-size: 19px;
    line-height: 1.5;
    color: var(--ink-soft);
  }
  .m-arg-lede::first-letter {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 3.4em;
    line-height: 0.86;
    float: left;
    padding: 5px 10px 0 0;
    color: var(--ink);
  }
  .m-finds {
    display: flex;
    flex-direction: column;
  }
  .m-find {
    padding: 16px 0;
    border-top: 1px solid var(--rule-hair);
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 12px;
  }
  .m-find:first-child { border-top: 1px solid var(--rule); }
  .m-find .n {
    font-family: var(--mono);
    font-size: 11px;
    color: var(--accent);
    padding-top: 3px;
    letter-spacing: 0.08em;
  }
  .m-find h4 {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    margin: 0 0 4px;
    line-height: 1.25;
  }
  .m-find p {
    font-family: var(--serif);
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-soft);
    margin: 0;
  }

  .m-sources {
    margin-top: 40px;
    padding: 18px 0 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 96px repeat(4, 1fr);
    gap: 32px;
    align-items: baseline;
  }
  .m-sources .lbl {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.18em;
    color: var(--muted);
    text-transform: uppercase;
    font-weight: 600;
  }
  .m-stat .n {
    font-family: var(--serif);
    font-feature-settings: "tnum";
    font-size: 32px;
    line-height: 1;
    font-weight: 500;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .m-stat .l {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 6px;
    font-weight: 500;
  }

  /* ── side notes / pull quotes ─────────────────── */
  .pull {
    margin: 32px 0;
    padding: 22px 28px;
    background: var(--paper-deep);
    border-left: 2px solid var(--accent);
    font-family: var(--serif);
    font-size: 17px;
    line-height: 1.45;
    color: var(--ink);
    max-width: 38em;
  }
  .pull .src {
    display: block;
    margin-top: 10px;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.16em;
    color: var(--muted);
    text-transform: uppercase;
    font-weight: 600;
  }

  /* ── style table ───────────────────────────────── */
  .tokens {
    margin-top: 28px;
    border-top: 1px solid var(--rule);
  }
  .tok-row {
    display: grid;
    grid-template-columns: 180px 1fr 220px;
    gap: 24px;
    padding: 14px 0;
    border-bottom: 1px solid var(--rule-hair);
    align-items: center;
  }
  .tok-row .name {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--ink);
  }
  .tok-row .desc {
    font-family: var(--serif);
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.4;
  }
  .tok-row .swatch {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11px;
    color: var(--muted);
  }
  .sw {
    width: 26px; height: 26px;
    border: 1px solid var(--rule-hair);
    border-radius: 0;
  }

  .tok-group-title {
    margin-top: 22px;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 600;
  }

  /* font specimens */
  .specimens {
    margin: 24px 0 8px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .spec {
    padding: 18px 18px 22px;
    border: 1px solid var(--rule-hair);
    background: var(--paper);
  }
  .spec .lbl {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 10px;
  }
  .spec .sample-1 { font-size: 28px; line-height: 1.05; letter-spacing: -0.015em; color: var(--ink); }
  .spec .sample-2 { font-size: 13px; color: var(--ink-soft); margin-top: 8px; }
  .spec .sample-3 { font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: var(--muted); margin-top: 14px; }
  .spec.serif .sample-1 { font-family: var(--serif); font-weight: 500; }
  .spec.serif .sample-2 { font-family: var(--serif); }
  .spec.sans  .sample-1 { font-family: var(--sans); font-weight: 600; }
  .spec.sans  .sample-2 { font-family: var(--sans); }
  .spec.mono  .sample-1 { font-family: var(--mono); font-weight: 500; }
  .spec.mono  .sample-2 { font-family: var(--mono); }

  /* before-after schematic */
  .ba {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin: 8px 0 0;
  }
  .ba-card {
    border: 1px solid var(--rule-hair);
    background: var(--paper);
    padding: 18px;
  }
  .ba-card .h {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 12px;
    font-weight: 600;
  }
  .ba-card.before .h { color: #8a4646; }
  .ba-card.after  .h { color: var(--sig-green); }
  .ba-card svg { display: block; width: 100%; height: auto; }

  /* footer */
  footer.colophon {
    margin-top: 120px;
    padding: 32px 0 0;
    border-top: 1px solid var(--rule);
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 24px;
  }
  footer.colophon b { color: var(--ink); font-weight: 600; }

  @media (max-width: 880px) {
    .article { padding: 0 24px 80px; }
    .section-header, .body-grid, .m-arg-grid, .m-sources { grid-template-columns: 1fr; gap: 18px; }
    .m-hero { grid-template-columns: 1fr; padding: 24px; }
    .m-exhibit { border-left: 0; padding-left: 0; border-top: 1px solid var(--rule); padding-top: 24px; margin-top: 8px; }
    .display { font-size: 44px; }
    .m-title { font-size: 36px; }
    .ba { grid-template-columns: 1fr; }
    .specimens { grid-template-columns: 1fr; }
    .tok-row { grid-template-columns: 1fr; gap: 6px; }
  }
</style>
</head>
<body>

<!-- ── masthead ───────────────────────────────────────────────── -->
<div class="masthead">
  <div class="masthead-inner">
    <div class="pub">Atlas&nbsp;·&nbsp;Design Review</div>
    <div class="meta">
      <span><b>Confidential</b></span>
      <span>For the Talent Atlas team</span>
      <span>May 24, 2026</span>
    </div>
  </div>
</div>

<!-- ── article ───────────────────────────────────────────────── -->
<article class="article">

  <!-- title block -->
  <div class="kicker"><span class="num">M0</span> Memorandum &nbsp;·&nbsp; Home page hierarchy</div>
  <h1 class="display">Notes on <em>the Atlas home.</em></h1>
  <p class="standfirst">
    The product reads as a serious public-source monitor — its restraint, its
    source-checked badges, its refusal to rank firms — but the home page still
    presents that material with the visual habits of a SaaS dashboard. Six notes
    on hierarchy, with a redesigned first two scrolls.
  </p>
  <div class="byline">
    <span><b>Reviewed</b>&nbsp; home, brief, four dossiers</span>
    <span><b>Reference</b>&nbsp; FT&thinsp;/&thinsp;Economist&thinsp;/&thinsp;McKinsey Quarterly</span>
    <span><b>Scope</b>&nbsp; Above the fold + style direction</span>
  </div>

  <!-- ═══════════════════════════════════════════════════════════
       § 1  CRITIQUE OF HIERARCHY
       ═════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="section-header">
      <div class="section-num">01 &nbsp; Hierarchy</div>
      <h2 class="section-title">The home is four sections doing the same job.</h2>
    </div>

    <div class="body-grid">
      <div class="gutter">Reading</div>
      <div class="prose">
        <p class="lede">
          A reader landing on the page meets the headline question — <em>Can China
          staff its chip-tooling push?</em> — and then, within two scrolls, encounters
          the same three findings restated in three different layouts: a four-card
          <em>Analyst Brief</em>, a three-card <em>Findings</em> row, and a
          comparator frame in the body. Each block carries a fresh eyebrow
          (<span style="font-family:var(--sans);font-size:13px;letter-spacing:.16em;text-transform:uppercase;">Analyst Brief · Findings · Comparator Frame · Listed-Company Disclosure</span>),
          which gives every block equal billing and erases the lede.
        </p>
        <p>
          The deeper problem is that the home asks the reader to <em>navigate</em> rather
          than <em>read</em>. The hero offers three primary CTAs of identical weight;
          the right column carries a <em>Core Question</em> pull-out that competes with
          the headline; the source counts (43, 143, 4, 4) — which are the single
          most important credibility signal on the page — are buried between
          Analyst Brief and Findings as a quiet strip.
        </p>
      </div>
    </div>

    <ul class="crit-list" style="margin-top:32px;">
      <li>
        <div>
          <h3>One lede, restated three times.</h3>
          <p>
            Sections 01 (Analyst Brief), 02 (Findings) and the dossier comparator
            all carry the same three takeaways — STEM is the wrong denominator,
            filings are the best window, customer-site support is invisible. Pick
            one section to deliver the argument and let the others do supporting
            work.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>The hero scatters attention.</h3>
          <p>
            Three CTAs of equal weight, plus a Core Question pull-out, plus a beta
            caveat, plus the title — the eye has nowhere to land. A McKinsey or FT
            opener has one primary entry (<em>Read the brief</em>) and lets a single
            exhibit do the talking on the right.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>Equal cards flatten the page.</h3>
          <p>
            White rounded-corner cards on a light gray field are SaaS dashboard
            grammar. A brief has rules, not cards: hairlines, marginalia, drop
            caps, indented standfirsts. Cards say <em>module</em>; rules say
            <em>publication</em>.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>Eyebrow inflation.</h3>
          <p>
            Almost every block opens with its own uppercase kicker. When everything
            is labelled, labels stop carrying any meaning. Reserve eyebrows for
            section openers; let in-section blocks rely on the section's existing
            frame.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>The credibility numbers are hidden.</h3>
          <p>
            <span style="font-family:var(--mono);font-size:13px;">43 / 143 / 4 / 4</span>
            is the answer to <em>“why should I trust this?”</em> It belongs near the
            standfirst, not buried six blocks down as a thin strip beside Findings.
          </p>
        </div>
      </li>
      <li>
        <div>
          <h3>The caveat is in the wrong place.</h3>
          <p>
            <em>“Beta public-source monitor. Counts show source coverage, not
            workforce size.”</em> is essential, but placing it under the headline
            dilutes the lede. Move it to a methodology note at the foot of the
            hero — visible, but not in headline weight.
          </p>
        </div>
      </li>
    </ul>
  </section>

  <!-- ═══════════════════════════════════════════════════════════
       § 2  REDESIGNED FIRST TWO SCROLLS
       ═════════════════════════════════════════════════════════ -->
  <section class="section">
    <div class="section-header">
      <div class="section-num">02 &nbsp; Layout</div>
      <h2 class="section-title">A stronger opening — two scrolls, one argument.</h2>
    </div>

    <div class="body-grid">
      <div class="gutter">Intent</div>
      <div class="prose">
        <p>
          The first scroll should answer three questions before the reader's
          thumb leaves the trackpad: <strong>what is this</strong>,
          <strong>what is its headline claim</strong>, and
          <strong>can I trust it</strong>. The second scroll should deliver the
          finding once — in prose, not in cards — and only then promote the
          source counts as the credibility band underneath.
        </p>
        <p>
          The mockup below uses real text and figures from the brief and dossiers.
          Visual mode is set against the current home: serif throughout, hairlines
          instead of card chrome, a single amber accent, one primary action.
        </p>
      </div>
    </div>

    <!-- mockup A: hero -->
    <div class="mock-wrap">
      <div class="mock-caption">
        <span><span class="label">Mockup A&nbsp;·</span> First scroll — hero</span>
        <span>1240&nbsp;×&nbsp;auto</span>
      </div>

      <div class="mock">
        <div class="m-hero">
          <!-- internal masthead -->
          <div class="m-mast">
            <div>China Semiconductor Tooling Talent Atlas</div>
            <div class="right">
              <span>Brief</span>
              <span>Firms</span>
              <span>Segments</span>
              <span>Explorer</span>
              <span><b>Search</b></span>
            </div>
          </div>

          <!-- left: title -->
          <div>
            <div class="m-kicker">Tooling Talent &nbsp;·&nbsp; Issue 04 &nbsp;·&nbsp; May 24, 2026</div>
            <h1 class="m-title">Can China staff its <em>chip-tooling</em> push?</h1>
            <p class="m-dek">
              Chinese toolmakers are adding products and R&amp;D staff. The harder
              test is whether they can build the field engineers, service teams
              and calibration routines that make equipment work inside customer
              fabs.
            </p>
            <div class="m-actions">
              <a class="m-cta primary" href="#">Read the brief →</a>
              <span class="m-secondary">
                or <a href="#">jump to firm dossiers</a>
                &nbsp;·&nbsp; <a href="#">inspect source rows</a>
              </span>
            </div>
            <p style="margin-top:22px; font-family:var(--sans); font-size:10px; letter-spacing:.12em; text-transform:uppercase; color:var(--muted);">
              Beta public-source monitor &nbsp;·&nbsp; counts reflect source coverage, not workforce size &nbsp;·&nbsp; <a href="#" style="color:var(--ink);">methodology</a>
            </p>
          </div>

          <!-- right: lede exhibit -->
          <div class="m-exhibit">
            <div class="e-cap">Exhibit 01 &nbsp;·&nbsp; Listed-firm disclosure</div>
            <div class="e-title">What the four anchors disclose.</div>

            <div class="e-row">
              <div class="firm">AMEC<small>Etch · Shanghai</small></div>
              <div class="figure">1,548<small>R&amp;D personnel</small></div>
            </div>
            <div class="e-row">
              <div class="firm">ACM Research<small>Wet clean · Shanghai</small></div>
              <div class="figure">1,228<small>Technical staff</small></div>
            </div>
            <div class="e-row">
              <div class="firm">NAURA<small>Deposition+ · Beijing</small></div>
              <div class="figure">21,101<small>Total employees</small></div>
            </div>
            <div class="e-row">
              <div class="firm">Piotech<small>Deposition · Shenyang</small></div>
              <div class="figure">638<small>R&amp;D personnel</small></div>
            </div>

            <p class="e-note">
              Categories are not interchangeable. R&amp;D, technical staff and
              total-employee counts should not be summed across firms. See
              dossiers for denominators.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- mockup B: argument -->
    <div class="mock-wrap" style="margin-top:24px;">
      <div class="mock-caption">
        <span><span class="label">Mockup B&nbsp;·</span> Second scroll — the argument</span>
        <span>Replaces sections 01 + 02 of the current home</span>
      </div>

      <div class="mock">
        <div class="m-arg">

          <div class="m-arg-head">
            <div class="m-arg-num">01 &nbsp; The argument</div>
            <h2 class="m-arg-title">The public record shows scale<br/>before customer-site depth.</h2>
          </div>

          <div class="m-arg-grid">
            <div></div>
            <div>
              <p class="m-arg-lede">
                Most coverage of China's chip-tooling push tracks the same
                scoreboard — a new etch platform from Shanghai, a fresh
                deposition tool out of Shenyang. The launches are genuine. They
                describe only the first half of what a foundry needs. The
                vendor-side question is not whether the box ships, but whether
                the firm shipping it can install, tune, match and recover the
                tool inside a customer's ramp. The public record now shows
                enough to say where that harder problem is being staffed and
                where it is still being skipped.
              </p>
            </div>

            <div class="m-finds">
              <div class="m-find">
                <div class="n">01</div>
                <div>
                  <h4>Broad STEM totals are the wrong denominator.</h4>
                  <p>Etch, deposition, metrology and lithography-adjacent tools
                  each draw on a different mix of plasma, thin-film, optical and
                  controls talent. A national graduate total collapses those
                  mixes into one number.</p>
                </div>
              </div>
              <div class="m-find">
                <div class="n">02</div>
                <div>
                  <h4>Listed-firm filings are the clearest workforce window.</h4>
                  <p>AMEC, ACM Research Shanghai, NAURA and Piotech disclose
                  more usable detail than education statistics — R&amp;D scale,
                  technical staff, degree mix, after-sales categories.</p>
                </div>
              </div>
              <div class="m-find">
                <div class="n">03</div>
                <div>
                  <h4>Customer-site support is the hardest layer to see.</h4>
                  <p>Product pages show ambition; filings show R&amp;D scale.
                  Whether a firm can install, tune and recover a tool inside a
                  customer fab — the package question — is barely disclosed.</p>
                </div>
              </div>
            </div>
          </div>

          <!-- credibility band -->
          <div class="m-sources">
            <div class="lbl">Source base</div>
            <div class="m-stat">
              <div class="n">43</div>
              <div class="l">Public sources</div>
            </div>
            <div class="m-stat">
              <div class="n">143</div>
              <div class="l">Evidence rows</div>
            </div>
            <div class="m-stat">
              <div class="n">4</div>
              <div class="l">Tool segments</div>
            </div>
            <div class="m-stat">
              <div class="n">4</div>
              <div class="l">Firm snapshots</div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <div class="body-grid" style="margin-top:36px;">
      <div class="gutter">What changed</div>
      <div class="prose">
        <p>
          The hero loses two CTAs and the right-column pull-out. In their place,
          a single primary action and an immediate exhibit — the four anchor
          firms with one disclosed figure each. The figures arrive before the
          argument, so the reader knows what they are about to be told something
          <em>about</em>.
        </p>
        <p>
          The second scroll consolidates the four-card Analyst Brief and the
          three-card Findings into a single argument page: one drop-cap
          paragraph that carries the case, three subordinate findings as
          numbered prose, and the credibility band (<span style="font-family:var(--mono);font-size:13px;">43 / 143 / 4 / 4</span>)
          promoted to the foot of the scroll where it belongs.
        </p>
        <p>
          The current dark <em>City signal map</em> and the firm dossier exhibit
          remain — they are the strongest pieces on the page. Place them third
          and fourth, after the argument has been made.
        </p>
      </div>
    </div>

    <!-- before / after schematics -->
    <div class="body-grid" style="margin-top:32px;">
      <div class="gutter">Schematic</div>
      <div style="grid-column: 2; width: 100%;">
        <div class="ba">
          <div class="ba-card before">
            <div class="h">Current — first two scrolls</div>
            <svg viewBox="0 0 320 360" xmlns="http://www.w3.org/2000/svg">
              <rect x="0" y="0" width="320" height="360" fill="#f3efe7"/>
              <!-- hero -->
              <rect x="14" y="14" width="200" height="14" fill="#c8c2b6"/>
              <rect x="14" y="36" width="190" height="42" fill="#1c1917"/>
              <rect x="14" y="86" width="170" height="10" fill="#c8c2b6"/>
